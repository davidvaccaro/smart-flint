{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["apps/server/src/**/*.ts", "apps/mock-ehr/src/**/*.ts", "packages/**/*.ts", "samples/cds-service/src/**/*.ts", "samples/fhir-service/src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "**/dist"]
}
