# For local synthetic development no .env is required: npm install && npm run dev
# Generate a production configuration with npm run configure -- --base-url=https://flint.example.com
NODE_ENV=production
DEMO_MODE=false
HOST=127.0.0.1
PORT=3001
BASE_URL=https://flint.example.com
CONSOLE_URL=https://flint.example.com
ENCRYPTION_KEY=
ADMIN_TOKEN=
# local: standalone username/password; oidc: organization sign-in without local password fallback.
ADMIN_AUTH_MODE=local
# Explicit first-owner setup only; automatically disabled after an active platform administrator exists.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_OIDC_AUTH_METHOD=none
# Comma-separated additional approved HTTPS endpoint origins; issuer origin is always included.
ADMIN_OIDC_ALLOWED_ORIGINS=
ADMIN_OIDC_LABEL=Organization sign-in
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://smart-flint:URL_SAFE_PASSWORD@localhost:5432/smart-flint
ALLOW_PRIVATE_NETWORKS=false
RETENTION_HOURS=24
# Fixed structured diagnostics; clinical payloads, URLs, query strings and credentials are omitted.
OPERATIONS_LOGGING=true
