<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="SMART Flint native example" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name="org.smartflint.example.SMARTFlintLaunchActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.smartflint.sample" android:host="callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
